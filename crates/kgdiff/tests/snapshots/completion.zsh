#compdef kgdiff
# zsh completion for kgdiff. Generated by `kgdiff completion zsh`.
#
#   source <(kgdiff completion zsh)       # in ~/.zshrc, after compinit, or
#   kgdiff completion zsh > ~/.zfunc/_kgdiff   # a directory of fpath, set before compinit

# The first argument is a command or the <before> file; a command only comes first.
_kgdiff_first() {
    if (( CURRENT != 2 )); then
        _files
        return
    fi
    _alternative \
        'commands:command:((apply\:"Apply a delta to a graph" help\:"Show help" completion\:"Print a shell completion script"))' \
        'files:file:_files'
}

_kgdiff() {
    local -a args
    if (( CURRENT > 2 )); then
        case ${words[2]} in
            apply)
                shift words
                (( CURRENT-- ))
                args=(
                    '(-h --help)--help[Show this help]'
                    '(-h --help)-h[Show this help]'
                    '(-v --version)--version[Show the version]'
                    '(-v --version)-v[Show the version]'
                    '(-q --quiet)--quiet[Print nothing on stdout]'
                    '(-q --quiet)-q[Print nothing on stdout]'
                    '--color=[auto, always, never]:color:(auto always never)'
                    '--locale=[Language of hunk titles and the report: en, zh-CN]:locale:(en zh-CN)'
                    '--lang=[RDF label language preference, e.g. zh,en]:lang: '
                    '--pretty[Indent the JSON output]'
                    '(-o --output)--output=[Write the patched graph to a file]:file:_files'
                    '(-o --output)-o+[Write the patched graph to a file]:file:_files'
                    '(-f --format)--format=[Format of <graph>]:format:(auto json jsonld turtle ntriples nquads trig rdfxml obo graphml)'
                    '(-f --format)-f+[Format of <graph>]:format:(auto json jsonld turtle ntriples nquads trig rdfxml obo graphml)'
                    '--no-strict[Apply the operations that fit even if the graph is not the delta'\''s base; reports how many were skipped]'
                    '--allow-empty[Treat an empty <graph> as an empty graph]'
                    '--verbose[With --no-strict, list the skipped operations]'
                )
                _arguments -s -S $args '1:graph:_files' '2:delta:_files'
                return ;;
            help)
                shift words
                (( CURRENT-- ))
                args=(
                    '--color=[auto, always, never]:color:(auto always never)'
                )
                _arguments -s -S $args '1:topic:(apply completion)'
                return ;;
            completion)
                shift words
                (( CURRENT-- ))
                args=(
                    '(-h --help)--help[Show this help]'
                    '(-h --help)-h[Show this help]'
                    '--color=[auto, always, never]:color:(auto always never)'
                )
                _arguments -s -S $args '1:shell:(bash zsh fish)'
                return ;;
        esac
    fi
    args=(
        '(-h --help)--help[Show this help]'
        '(-h --help)-h[Show this help]'
        '(-v --version)--version[Show the version]'
        '(-v --version)-v[Show the version]'
        '(-q --quiet)--quiet[Print nothing on stdout (files are still written)]'
        '(-q --quiet)-q[Print nothing on stdout (files are still written)]'
        '--color=[auto, always, never (auto honours NO_COLOR and FORCE_COLOR)]:color:(auto always never)'
        '--locale=[Language of hunk titles and the report: en, zh-CN]:locale:(en zh-CN)'
        '--lang=[RDF label language preference, comma-separated, e.g. zh,en]:lang: '
        '--pretty[Indent JSON output]'
        '--stat[Diffstat only: counters, bar, node and edge counts, changes by type]'
        '--name-status[One line per hunk: A added, D removed, M modified, R renamed, V moved, G merged, S split, E relations]'
        '--json=[Full machine-readable diff (DiffJSON)]::file:_files'
        '--delta=[Invertible delta only, for kgdiff apply]::file:_files'
        '--markdown=[GitHub-flavoured Markdown for PR comments and job summaries]::file:_files'
        '(-o --html)--html=[Self-contained interactive HTML report (works offline)]:file:_files'
        '(-o --html)-o+[Self-contained interactive HTML report (works offline)]:file:_files'
        '--open[Open the HTML report in the browser (a temporary file without -o)]'
        '(-f --format)--format=[Input format: auto, json, jsonld, turtle, ntriples, nquads, trig, rdfxml, obo, graphml]:format:(auto json jsonld turtle ntriples nquads trig rdfxml obo graphml)'
        '(-f --format)-f+[Input format: auto, json, jsonld, turtle, ntriples, nquads, trig, rdfxml, obo, graphml]:format:(auto json jsonld turtle ntriples nquads trig rdfxml obo graphml)'
        '--before-format=[Format of <before> only]:before-format:(auto json jsonld turtle ntriples nquads trig rdfxml obo graphml)'
        '--after-format=[Format of <after> only]:after-format:(auto json jsonld turtle ntriples nquads trig rdfxml obo graphml)'
        '--match=[Node matching: id, auto, similarity]:match:(id auto similarity)'
        '--threshold=[Similarity acceptance threshold, 0–1]:threshold: '
        '--edge-identity=[Edge identity: structure, id]:edge-identity:(structure id)'
        '*--hierarchy=[Hierarchy predicate (repeatable); replaces the defaults when given]:hierarchy: '
        '*--ignore-attr=[Ignore an attribute when comparing (repeatable)]:ignore-attr: '
        '--no-merges[Do not detect merges]'
        '--no-splits[Do not detect splits]'
        '--title=[Title of the summary and report]:title: '
        '--theme=[Initial theme: auto, light, dark]:theme:(auto light dark)'
        '--mode=[Initial viewer mode: overlay, swipe, replay]:mode:(overlay swipe replay changes)'
        '--scope=[Show the whole graph or only the changes (in any mode): all, changes]:scope:(all changes)'
        '*--panels=[Initial panel states, e.g. "detail:collapsed minimap:hidden" (repeatable)]:panels: '
        '--reproducible[Omit the timestamp: byte-identical reports for identical input]'
        '--no-compute[Leave out the viewer compute add-on (by default inlined for large graphs laid out around their changes, so collapsed groups can be expanded)]'
        '--allow-empty[Treat an empty input as an empty graph (otherwise an empty file or stdin is an error)]'
        '--exit-code[Exit with 1 when the graphs differ, like git diff --exit-code]'
        '--limit=[Hunks listed in the summary; 0 lists all]:limit: '
        '*--watch-attr=[Flag changes to this attribute ⚑ for review first (repeatable); replaces the defaults]:watch-attr: '
    )
    _arguments -s -S $args '1: :_kgdiff_first' '2:after:_files'
}

if [[ "${funcstack[1]}" == "_kgdiff" ]]; then
    _kgdiff "$@"
else
    compdef _kgdiff kgdiff
fi
