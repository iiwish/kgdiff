# OBO-style OWL in Turtle (as produced by ROBOT / the OWL API).
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .

<http://purl.obolibrary.org/obo/go.owl> a owl:Ontology ;
    owl:versionIRI <http://purl.obolibrary.org/obo/go/releases/2024-01-17/go.owl> ;
    owl:versionInfo "2024-01-17" ;
    oboInOwl:default-namespace "gene_ontology" .

obo:IAO_0000115 a owl:AnnotationProperty ;
    rdfs:label "definition" .

obo:BFO_0000050 a owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    oboInOwl:shorthand "part_of" .

obo:GO_0008150 a owl:Class ;
    rdfs:label "biological_process"^^xsd:string ;
    obo:IAO_0000115 "A biological process is the execution of a genetically-encoded biological module or program."^^xsd:string ;
    oboInOwl:hasExactSynonym "biological process"^^xsd:string, "physiological process"^^xsd:string ;
    oboInOwl:hasAlternativeId "GO:0000004"^^xsd:string, "GO:0007582"^^xsd:string ;
    oboInOwl:hasOBONamespace "biological_process"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/go#goslim_generic> ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/go.owl> .

obo:GO_0005739 a owl:Class ;
    rdfs:label "mitochondrion"@en ;
    rdfs:subClassOf obo:GO_0043231 ,
        [ a owl:Restriction ;
          owl:onProperty obo:BFO_0000050 ;
          owl:someValuesFrom obo:GO_0005737 ] .

obo:GO_0031966 a owl:Class ;
    rdfs:label "mitochondrial membrane"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( obo:GO_0016020
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000050 ; owl:someValuesFrom obo:GO_0005740 ] )
    ] ;
    rdfs:subClassOf obo:GO_0031090 .

obo:GO_0000005 a owl:Class ;
    rdfs:label "obsolete ribosomal chaperone activity" ;
    owl:deprecated true ;
    obo:IAO_0100001 obo:GO_0042254 ;
    oboInOwl:consider "GO:0042254", "GO:0044183" .

# Axiom annotations, OWL API style.
[] a owl:Axiom ;
    owl:annotatedSource obo:GO_0008150 ;
    owl:annotatedProperty obo:IAO_0000115 ;
    owl:annotatedTarget "A biological process is the execution of a genetically-encoded biological module or program."^^xsd:string ;
    oboInOwl:hasDbXref "GOC:pdt"^^xsd:string .

[] a owl:Axiom ;
    owl:annotatedSource obo:GO_0005739 ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedTarget [ a owl:Restriction ; owl:onProperty obo:BFO_0000050 ; owl:someValuesFrom obo:GO_0005737 ] ;
    oboInOwl:source "GOC:mah" .
