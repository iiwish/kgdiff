{
  "name": "kgdiff-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "git diff for knowledge graphs: semantic, visual diff and review for graph data.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck && tsc -p tests && tsc -p action && tsc -p conformance",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:packages": "tsx scripts/check-packages.ts",
    "conformance:update": "tsx conformance/update.ts",
    "conformance:replay": "tsx conformance/replay.ts",
    "dev:site": "pnpm --filter @kgdiff/site dev",
    "dev:docs": "pnpm --filter @kgdiff/docs dev",
    "build:docs": "pnpm --filter @kgdiff/docs build",
    "build:site": "pnpm vite build --config apps/site/vite.config.ts && pnpm build:docs",
    "changeset": "changeset",
    "version-packages": "changeset version && biome format --write packages && tsx scripts/sync-citation.ts && tsx scripts/sync-versions.ts",
    "release": "pnpm check && pnpm build && pnpm check:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "5.57.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript5": "npm:typescript@5.4.5",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  }
}
