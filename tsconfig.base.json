{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@kgdiff/viewer/panels": ["./packages/viewer/src/panels.ts"],
      "@kgdiff/viewer/react": ["./packages/viewer/src/react.ts"],
      "@kgdiff/core/computed": ["./packages/core/src/computed.ts"],
      "@kgdiff/compute/layout": ["./packages/compute/src/layout.ts"],
      "@kgdiff/compute": ["./types/compute-stub.d.ts"],
      "@kgdiff/*": ["./packages/*/src/index.ts"]
    }
  }
}
