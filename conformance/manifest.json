    {
      "id": "dataset-enterprise-kg",
      "covers": [
        "dataset",
        "kgdiff-json",
        "zh-CN",
        "merge:hint",
        "move",
        "retarget",
        "rename",
        "predicate",
        "types"
      ]
    },
