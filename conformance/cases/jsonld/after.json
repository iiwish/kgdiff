      "score": 0.15,
      "knows": ["ex:bob", "ex:carol"],
      "memberOf": "ex:acme",
      "data": { "2": { "z": null }, "a": [1, 2, 0], "10": 2, "b": 1 }
    },
    {
      "@id": "ex:bob",
      "@type": "Person",
      "name": "Bob",
      "big": 1E21,
      "small": 1.0e-7,
      "count": 1e20,
