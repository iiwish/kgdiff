{
  "id": "jsonld",
  "description": "JSON-LD 1.1 with an inline context (@vocab, typed terms, @json, @reverse, language maps), native numbers that become xsd:integer / xsd:double literals, and an after file that is JSON-LD under a .json name.",
  "covers": [
    "jsonld",
    "json-ld-detection",
    "json-literal",
    "reverse",
    "numbers",
    "languages"
  ],
  "inputs": {
    "before": "before.jsonld",
    "after": "after.json"
  },
  "parse": {
    "before": {
      "format": "auto",
      "filename": "before.jsonld",
      "allowEmpty": false
    },
    "after": {
      "format": "auto",
      "filename": "after.json",
      "allowEmpty": false
    }
  },
  "options": {
    "match": {
      "strategy": "id"
    }
  },
  "resolvedOptions": {
    "match": {
      "strategy": "id",
      "threshold": 0.82,
      "suggestThreshold": 0.6,
      "maxCandidates": 8
    },
    "edgeIdentity": "structure",
    "hierarchyPredicates": [
      "rdfs:subClassOf",
      "http://www.w3.org/2000/01/rdf-schema#subClassOf",
      "rdfs:subPropertyOf",
      "http://www.w3.org/2000/01/rdf-schema#subPropertyOf",
      "skos:broader",
      "http://www.w3.org/2004/02/skos/core#broader",
      "is_a",
      "subClassOf",
      "parent"
    ],
    "detectMerges": true,
    "detectSplits": true,
    "ignoreAttrs": []
  },
  "locale": "en",
  "layoutOptions": {},
  "identical": false,
  "cli": [
    {
      "name": "summary",
      "args": [
        "before.jsonld",
        "after.json",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "stat",
      "args": [
        "before.jsonld",
        "after.json",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--stat"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/stat.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "name-status",
      "args": [
        "before.jsonld",
        "after.json",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--name-status"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/name-status.tsv"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "markdown",
      "args": [
        "before.jsonld",
        "after.json",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--markdown"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.md"
      },
      "versionPlaceholder": true,
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "json",
      "args": [
        "before.jsonld",
        "after.json",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--json"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/diff.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "delta",
      "args": [
        "before.jsonld",
        "after.json",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--delta"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/delta.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "exit-code",
      "args": [
        "before.jsonld",
        "after.json",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--exit-code",
        "--quiet"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": ""
      },
      "exit": 1
    },
    {
      "name": "apply",
      "args": [
        "apply",
        "before.jsonld",
        "expected/delta.json",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/apply.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    }
  ]
}
