{
  "id": "ignore-attrs-delta",
  "description": "Ignored attributes in the delta, under similarity matching: on an unchanged node, on a node renamed alone and on one renamed in a hunk, on an unchanged edge whose endpoint a hunk renames, on a modified edge, on a parallel copy; none of them shown as a change.",
  "covers": [
    "kgdiff-json",
    "ignore-attr",
    "similarity",
    "parallel-edges"
  ],
  "inputs": {
    "before": "before.json",
    "after": "after.json"
  },
  "parse": {
    "before": {
      "format": "auto",
      "filename": "before.json",
      "allowEmpty": false
    },
    "after": {
      "format": "auto",
      "filename": "after.json",
      "allowEmpty": false
    }
  },
  "options": {
    "match": {
      "strategy": "similarity"
    },
    "ignoreAttrs": [
      "etag",
      "ts"
    ]
  },
  "resolvedOptions": {
    "match": {
      "strategy": "similarity",
      "threshold": 0.82,
      "suggestThreshold": 0.6,
      "maxCandidates": 8
    },
    "edgeIdentity": "structure",
    "hierarchyPredicates": [
      "rdfs:subClassOf",
      "http://www.w3.org/2000/01/rdf-schema#subClassOf",
      "rdfs:subPropertyOf",
      "http://www.w3.org/2000/01/rdf-schema#subPropertyOf",
      "skos:broader",
      "http://www.w3.org/2004/02/skos/core#broader",
      "is_a",
      "subClassOf",
      "parent"
    ],
    "detectMerges": true,
    "detectSplits": true,
    "ignoreAttrs": [
      "etag",
      "ts"
    ]
  },
  "locale": "en",
  "layoutOptions": {},
  "identical": false,
  "cli": [
    {
      "name": "summary",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "similarity",
        "--ignore-attr",
        "etag",
        "--ignore-attr",
        "ts",
        "--locale",
        "en",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.txt"
      },
      "stderr": {
        "text": "warning: before.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\nwarning: after.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\n"
      },
      "exit": 0
    },
    {
      "name": "stat",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "similarity",
        "--ignore-attr",
        "etag",
        "--ignore-attr",
        "ts",
        "--locale",
        "en",
        "--color",
        "never",
        "--stat"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/stat.txt"
      },
      "stderr": {
        "text": "warning: before.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\nwarning: after.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\n"
      },
      "exit": 0
    },
    {
      "name": "name-status",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "similarity",
        "--ignore-attr",
        "etag",
        "--ignore-attr",
        "ts",
        "--locale",
        "en",
        "--color",
        "never",
        "--name-status"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/name-status.tsv"
      },
      "stderr": {
        "text": "warning: before.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\nwarning: after.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\n"
      },
      "exit": 0
    },
    {
      "name": "markdown",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "similarity",
        "--ignore-attr",
        "etag",
        "--ignore-attr",
        "ts",
        "--locale",
        "en",
        "--color",
        "never",
        "--markdown"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.md"
      },
      "versionPlaceholder": true,
      "stderr": {
        "text": "warning: before.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\nwarning: after.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\n"
      },
      "exit": 0
    },
    {
      "name": "json",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "similarity",
        "--ignore-attr",
        "etag",
        "--ignore-attr",
        "ts",
        "--locale",
        "en",
        "--color",
        "never",
        "--json"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/diff.json"
      },
      "stderr": {
        "text": "warning: before.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\nwarning: after.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\n"
      },
      "exit": 0
    },
    {
      "name": "delta",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "similarity",
        "--ignore-attr",
        "etag",
        "--ignore-attr",
        "ts",
        "--locale",
        "en",
        "--color",
        "never",
        "--delta"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/delta.json"
      },
      "stderr": {
        "text": "warning: before.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\nwarning: after.json: Edge [\"n3\",\"par\",\"n4\"] has 2 parallel copies; they are keyed #2, #3…\n"
      },
      "exit": 0
    },
    {
      "name": "exit-code",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "similarity",
        "--ignore-attr",
        "etag",
        "--ignore-attr",
        "ts",
        "--locale",
        "en",
        "--color",
        "never",
        "--exit-code",
        "--quiet"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": ""
      },
      "exit": 1
    },
    {
      "name": "apply",
      "args": [
        "apply",
        "before.json",
        "expected/delta.json",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/apply.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    }
  ]
}
