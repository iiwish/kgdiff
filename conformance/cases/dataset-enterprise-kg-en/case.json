{
  "id": "dataset-enterprise-kg-en",
  "description": "The same ontology with every text in English (examples/datasets/enterprise-kg-en).",
  "covers": [
    "dataset",
    "kgdiff-json",
    "merge:hint",
    "move",
    "retarget",
    "rename"
  ],
  "inputs": {
    "before": "before.json",
    "after": "after.json"
  },
  "copiedFrom": {
    "before": "examples/datasets/enterprise-kg-en/before.json",
    "after": "examples/datasets/enterprise-kg-en/after.json"
  },
  "parse": {
    "before": {
      "format": "auto",
      "filename": "before.json",
      "allowEmpty": false
    },
    "after": {
      "format": "auto",
      "filename": "after.json",
      "allowEmpty": false
    }
  },
  "options": {
    "match": {
      "strategy": "auto"
    },
    "hierarchyPredicates": [
      "is_a"
    ]
  },
  "resolvedOptions": {
    "match": {
      "strategy": "auto",
      "threshold": 0.82,
      "suggestThreshold": 0.6,
      "maxCandidates": 8
    },
    "edgeIdentity": "structure",
    "hierarchyPredicates": [
      "is_a"
    ],
    "detectMerges": true,
    "detectSplits": true,
    "ignoreAttrs": []
  },
  "locale": "en",
  "layoutOptions": {},
  "identical": false,
  "cli": [
    {
      "name": "summary",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "stat",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--stat"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/stat.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "name-status",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--name-status"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/name-status.tsv"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "markdown",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--markdown"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.md"
      },
      "versionPlaceholder": true,
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "json",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--json"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/diff.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "delta",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--delta"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/delta.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "exit-code",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--exit-code",
        "--quiet"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": ""
      },
      "exit": 1
    },
    {
      "name": "apply",
      "args": [
        "apply",
        "before.json",
        "expected/delta.json",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/apply.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    }
  ]
}
