{
  "id": "match-id-hints",
  "description": "A semantic-layer skeleton → enriched export matched by id: 1:1 rekeys through `replaces`, a merge of two hinted sources, a split of one source into two hinted targets, a deprecation with `replacedBy`, a move, a rename, a watched definition change and a self-loop that is rekeyed.",
  "covers": [
    "kgdiff-json",
    "match:id",
    "hint:replaces",
    "hint:replacedBy",
    "rekey",
    "merge:hint",
    "split:hint",
    "deprecate",
    "move",
    "rename",
    "self-loop",
    "retarget:merge",
    "watch"
  ],
  "inputs": {
    "before": "before.json",
    "after": "after.json"
  },
  "parse": {
    "before": {
      "format": "auto",
      "filename": "before.json",
      "allowEmpty": false
    },
    "after": {
      "format": "auto",
      "filename": "after.json",
      "allowEmpty": false
    }
  },
  "options": {
    "match": {
      "strategy": "id"
    },
    "hierarchyPredicates": [
      "subClassOf"
    ]
  },
  "resolvedOptions": {
    "match": {
      "strategy": "id",
      "threshold": 0.82,
      "suggestThreshold": 0.6,
      "maxCandidates": 8
    },
    "edgeIdentity": "structure",
    "hierarchyPredicates": [
      "subClassOf"
    ],
    "detectMerges": true,
    "detectSplits": true,
    "ignoreAttrs": []
  },
  "locale": "en",
  "layoutOptions": {},
  "identical": false,
  "cli": [
    {
      "name": "summary",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "stat",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never",
        "--stat"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/stat.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "name-status",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never",
        "--name-status"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/name-status.tsv"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "markdown",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never",
        "--markdown"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.md"
      },
      "versionPlaceholder": true,
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "json",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never",
        "--json"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/diff.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "delta",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never",
        "--delta"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/delta.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "exit-code",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never",
        "--exit-code",
        "--quiet"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": ""
      },
      "exit": 1
    },
    {
      "name": "summary-zh",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never",
        "--locale",
        "zh-CN"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.zh-CN.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "markdown-zh",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never",
        "--locale",
        "zh-CN",
        "--markdown"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.zh-CN.md"
      },
      "versionPlaceholder": true,
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "apply",
      "args": [
        "apply",
        "before.json",
        "expected/delta.json",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/apply.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "summary-stdin",
      "args": [
        "-",
        "after.json",
        "--match",
        "id",
        "--hierarchy",
        "subClassOf",
        "--locale",
        "en",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdin": {
        "file": "before.json"
      },
      "stdout": {
        "file": "expected/cli/summary.stdin.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "apply-stdin",
      "args": [
        "apply",
        "-",
        "expected/delta.json",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdin": {
        "file": "before.json"
      },
      "stdout": {
        "file": "expected/cli/apply.stdin.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    }
  ]
}
