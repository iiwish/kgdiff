[Term]
id: EX:0000001
name: organism
def: "A living thing that grows and reproduces." [EX:curator, PMID:123]

[Term]
id: EX:0000002
name: Animal
synonym: "beast" EXACT []
synonym: "creature" RELATED [EX:curator]
synonym: "fauna" BROAD []
is_a: EX:0000001 ! organism

[Term]
