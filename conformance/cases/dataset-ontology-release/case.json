{
  "id": "dataset-ontology-release",
  "description": "A monthly OBO release of a mini disease ontology (examples/datasets/ontology-release).",
  "covers": [
    "dataset",
    "obo",
    "match:id",
    "merge:replaced_by",
    "split",
    "deprecate",
    "move",
    "synonyms",
    "xrefs"
  ],
  "inputs": {
    "before": "before.obo",
    "after": "after.obo"
  },
  "copiedFrom": {
    "before": "examples/datasets/ontology-release/before.obo",
    "after": "examples/datasets/ontology-release/after.obo"
  },
  "parse": {
    "before": {
      "format": "auto",
      "filename": "before.obo",
      "allowEmpty": false
    },
    "after": {
      "format": "auto",
      "filename": "after.obo",
      "allowEmpty": false
    }
  },
  "options": {
    "match": {
      "strategy": "id"
    },
    "hierarchyPredicates": [
      "is_a"
    ]
  },
  "resolvedOptions": {
    "match": {
      "strategy": "id",
      "threshold": 0.82,
      "suggestThreshold": 0.6,
      "maxCandidates": 8
    },
    "edgeIdentity": "structure",
    "hierarchyPredicates": [
      "is_a"
    ],
    "detectMerges": true,
    "detectSplits": true,
    "ignoreAttrs": []
  },
  "locale": "en",
  "layoutOptions": {},
  "identical": false,
  "cli": [
    {
      "name": "summary",
      "args": [
        "before.obo",
        "after.obo",
        "--match",
        "id",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "stat",
      "args": [
        "before.obo",
        "after.obo",
        "--match",
        "id",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--stat"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/stat.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "name-status",
      "args": [
        "before.obo",
        "after.obo",
        "--match",
        "id",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--name-status"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/name-status.tsv"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "markdown",
      "args": [
        "before.obo",
        "after.obo",
        "--match",
        "id",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--markdown"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.md"
      },
      "versionPlaceholder": true,
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "json",
      "args": [
        "before.obo",
        "after.obo",
        "--match",
        "id",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--json"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/diff.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "delta",
      "args": [
        "before.obo",
        "after.obo",
        "--match",
        "id",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--delta"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/delta.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "exit-code",
      "args": [
        "before.obo",
        "after.obo",
        "--match",
        "id",
        "--hierarchy",
        "is_a",
        "--locale",
        "en",
        "--color",
        "never",
        "--exit-code",
        "--quiet"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": ""
      },
      "exit": 1
    },
    {
      "name": "apply",
      "args": [
        "apply",
        "before.obo",
        "expected/delta.json",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/apply.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    }
  ]
}
