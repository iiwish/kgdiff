{
  "id": "rdf-turtle-ntriples",
  "description": "Turtle before, N-Triples after: typed literals (integer, decimal, double, boolean, an unsafe integer, an ill-formed integer), language-tagged labels with a language preference, synonyms, blank nodes, an OWL existential restriction, owl:deprecated with IAO:0100001.",
  "covers": [
    "turtle",
    "ntriples",
    "typed-literals",
    "languages",
    "blank-nodes",
    "owl-restriction",
    "deprecate",
    "cross-format"
  ],
  "inputs": {
    "before": "before.ttl",
    "after": "after.nt"
  },
  "parse": {
    "before": {
      "format": "auto",
      "filename": "before.ttl",
      "languages": [
        "zh",
        "en"
      ],
      "allowEmpty": false
    },
    "after": {
      "format": "auto",
      "filename": "after.nt",
      "languages": [
        "zh",
        "en"
      ],
      "allowEmpty": false
    }
  },
  "options": {
    "match": {
      "strategy": "id"
    }
  },
  "resolvedOptions": {
    "match": {
      "strategy": "id",
      "threshold": 0.82,
      "suggestThreshold": 0.6,
      "maxCandidates": 8
    },
    "edgeIdentity": "structure",
    "hierarchyPredicates": [
      "rdfs:subClassOf",
      "http://www.w3.org/2000/01/rdf-schema#subClassOf",
      "rdfs:subPropertyOf",
      "http://www.w3.org/2000/01/rdf-schema#subPropertyOf",
      "skos:broader",
      "http://www.w3.org/2004/02/skos/core#broader",
      "is_a",
      "subClassOf",
      "parent"
    ],
    "detectMerges": true,
    "detectSplits": true,
    "ignoreAttrs": []
  },
  "locale": "en",
  "layoutOptions": {},
  "identical": false,
  "cli": [
    {
      "name": "summary",
      "args": [
        "before.ttl",
        "after.nt",
        "--lang",
        "zh,en",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "stat",
      "args": [
        "before.ttl",
        "after.nt",
        "--lang",
        "zh,en",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--stat"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/stat.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "name-status",
      "args": [
        "before.ttl",
        "after.nt",
        "--lang",
        "zh,en",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--name-status"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/name-status.tsv"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "markdown",
      "args": [
        "before.ttl",
        "after.nt",
        "--lang",
        "zh,en",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--markdown"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.md"
      },
      "versionPlaceholder": true,
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "json",
      "args": [
        "before.ttl",
        "after.nt",
        "--lang",
        "zh,en",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--json"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/diff.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "delta",
      "args": [
        "before.ttl",
        "after.nt",
        "--lang",
        "zh,en",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--delta"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/delta.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "exit-code",
      "args": [
        "before.ttl",
        "after.nt",
        "--lang",
        "zh,en",
        "--match",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--exit-code",
        "--quiet"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": ""
      },
      "exit": 1
    },
    {
      "name": "apply",
      "args": [
        "apply",
        "before.ttl",
        "expected/delta.json",
        "--lang",
        "zh,en",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/apply.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    }
  ]
}
