{
  "id": "edge-identity-id",
  "description": "Edges identified by their ids (`--edge-identity id`): an edge that keeps its id while its target and its predicate change, a label change, an attribute change, edges without ids, an id that looks like a structural key and a repeated edge id.",
  "covers": [
    "kgdiff-json",
    "edge-identity:id",
    "retarget",
    "predicate",
    "edge-label",
    "edge-attrs"
  ],
  "inputs": {
    "before": "before.json",
    "after": "after.json"
  },
  "parse": {
    "before": {
      "format": "auto",
      "filename": "before.json",
      "allowEmpty": false
    },
    "after": {
      "format": "auto",
      "filename": "after.json",
      "allowEmpty": false
    }
  },
  "options": {
    "match": {
      "strategy": "auto"
    },
    "edgeIdentity": "id"
  },
  "resolvedOptions": {
    "match": {
      "strategy": "auto",
      "threshold": 0.82,
      "suggestThreshold": 0.6,
      "maxCandidates": 8
    },
    "edgeIdentity": "id",
    "hierarchyPredicates": [
      "rdfs:subClassOf",
      "http://www.w3.org/2000/01/rdf-schema#subClassOf",
      "rdfs:subPropertyOf",
      "http://www.w3.org/2000/01/rdf-schema#subPropertyOf",
      "skos:broader",
      "http://www.w3.org/2004/02/skos/core#broader",
      "is_a",
      "subClassOf",
      "parent"
    ],
    "detectMerges": true,
    "detectSplits": true,
    "ignoreAttrs": []
  },
  "locale": "en",
  "layoutOptions": {},
  "identical": false,
  "cli": [
    {
      "name": "summary",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--edge-identity",
        "id",
        "--locale",
        "en",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.txt"
      },
      "stderr": {
        "text": "warning: before.json: Edge id \"e5\" is used 2 times; the declarations were merged\n"
      },
      "exit": 0
    },
    {
      "name": "stat",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--edge-identity",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--stat"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/stat.txt"
      },
      "stderr": {
        "text": "warning: before.json: Edge id \"e5\" is used 2 times; the declarations were merged\n"
      },
      "exit": 0
    },
    {
      "name": "name-status",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--edge-identity",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--name-status"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/name-status.tsv"
      },
      "stderr": {
        "text": "warning: before.json: Edge id \"e5\" is used 2 times; the declarations were merged\n"
      },
      "exit": 0
    },
    {
      "name": "markdown",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--edge-identity",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--markdown"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.md"
      },
      "versionPlaceholder": true,
      "stderr": {
        "text": "warning: before.json: Edge id \"e5\" is used 2 times; the declarations were merged\n"
      },
      "exit": 0
    },
    {
      "name": "json",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--edge-identity",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--json"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/diff.json"
      },
      "stderr": {
        "text": "warning: before.json: Edge id \"e5\" is used 2 times; the declarations were merged\n"
      },
      "exit": 0
    },
    {
      "name": "delta",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--edge-identity",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--delta"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/delta.json"
      },
      "stderr": {
        "text": "warning: before.json: Edge id \"e5\" is used 2 times; the declarations were merged\n"
      },
      "exit": 0
    },
    {
      "name": "exit-code",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--edge-identity",
        "id",
        "--locale",
        "en",
        "--color",
        "never",
        "--exit-code",
        "--quiet"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": ""
      },
      "exit": 1
    },
    {
      "name": "apply",
      "args": [
        "apply",
        "before.json",
        "expected/delta.json",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/apply.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    }
  ]
}
