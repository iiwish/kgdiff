{
  "id": "synthetic-600",
  "description": "A 600-node synthetic pair with CJK labels from `pnpm tsx scripts/gen-synthetic.ts --nodes 600 --seed 7 --cjk` (inputs committed as generated): merges, moves, retargets, rekeys and deprecations at scale; the layout record covers a changes-only scope.",
  "covers": [
    "kgdiff-json",
    "synthetic",
    "cjk",
    "scale",
    "layout:changes"
  ],
  "inputs": {
    "before": "before.json",
    "after": "after.json"
  },
  "parse": {
    "before": {
      "format": "auto",
      "filename": "before.json",
      "allowEmpty": false
    },
    "after": {
      "format": "auto",
      "filename": "after.json",
      "allowEmpty": false
    }
  },
  "options": {
    "match": {
      "strategy": "auto"
    }
  },
  "resolvedOptions": {
    "match": {
      "strategy": "auto",
      "threshold": 0.82,
      "suggestThreshold": 0.6,
      "maxCandidates": 8
    },
    "edgeIdentity": "structure",
    "hierarchyPredicates": [
      "rdfs:subClassOf",
      "http://www.w3.org/2000/01/rdf-schema#subClassOf",
      "rdfs:subPropertyOf",
      "http://www.w3.org/2000/01/rdf-schema#subPropertyOf",
      "skos:broader",
      "http://www.w3.org/2004/02/skos/core#broader",
      "is_a",
      "subClassOf",
      "parent"
    ],
    "detectMerges": true,
    "detectSplits": true,
    "ignoreAttrs": []
  },
  "locale": "zh-CN",
  "layoutOptions": {
    "scope": "changes"
  },
  "identical": false,
  "cli": [
    {
      "name": "summary",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--locale",
        "zh-CN",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "stat",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--locale",
        "zh-CN",
        "--color",
        "never",
        "--stat"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/stat.txt"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "name-status",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--locale",
        "zh-CN",
        "--color",
        "never",
        "--name-status"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/name-status.tsv"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "markdown",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--locale",
        "zh-CN",
        "--color",
        "never",
        "--markdown"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/cli/summary.md"
      },
      "versionPlaceholder": true,
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "json",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--locale",
        "zh-CN",
        "--color",
        "never",
        "--json"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/diff.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "delta",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--locale",
        "zh-CN",
        "--color",
        "never",
        "--delta"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/delta.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    },
    {
      "name": "exit-code",
      "args": [
        "before.json",
        "after.json",
        "--match",
        "auto",
        "--locale",
        "zh-CN",
        "--color",
        "never",
        "--exit-code",
        "--quiet"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": ""
      },
      "exit": 1
    },
    {
      "name": "apply",
      "args": [
        "apply",
        "before.json",
        "expected/delta.json",
        "--color",
        "never"
      ],
      "env": {
        "COLUMNS": "100"
      },
      "stdout": {
        "file": "expected/apply.json"
      },
      "stderr": {
        "text": ""
      },
      "exit": 0
    }
  ]
}
