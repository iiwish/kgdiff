{
  "name": "@kgdiff/cli",
  "version": "0.7.0",
  "description": "git diff for knowledge graphs. Compare two graph files from the terminal, CI, or as a shareable HTML report.",
  "keywords": [
    "kgdiff",
    "cli",
    "diff",
    "knowledge-graph",
    "ontology",
    "rdf"
  ],
  "homepage": "https://github.com/iiwish/kgdiff/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/iiwish/kgdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/kgdiff.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "iiwish",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "kgdiff": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kgdiff/core": "workspace:*",
    "@kgdiff/formats": "workspace:*",
    "@kgdiff/layout": "workspace:*",
    "@kgdiff/scene": "workspace:*",
    "@kgdiff/viewer": "workspace:*"
  }
}
