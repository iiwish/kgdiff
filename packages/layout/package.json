{
  "name": "@kgdiff/layout",
  "version": "0.8.0",
  "description": "Stable, deterministic, label-aware layout for graph diffs: both versions share one mental map.",
  "keywords": [
    "kgdiff",
    "layout",
    "force-directed"
  ],
  "homepage": "https://github.com/iiwish/kgdiff/tree/main/packages/layout#readme",
  "bugs": {
    "url": "https://github.com/iiwish/kgdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/kgdiff.git",
    "directory": "packages/layout"
  },
  "license": "MIT",
  "author": "iiwish",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kgdiff/core": "workspace:*",
    "d3-force": "3.0.0",
    "d3-quadtree": "3.0.1"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/d3-quadtree": "3.0.6"
  }
}
