{
  "name": "@kgdiff/g6",
  "version": "0.11.0",
  "description": "AntV G6 v5 adapter for kgdiff: render semantic graph diffs inside your G6 graphs.",
  "keywords": [
    "kgdiff",
    "antv",
    "g6",
    "adapter"
  ],
  "homepage": "https://github.com/iiwish/kgdiff/tree/main/packages/g6#readme",
  "bugs": {
    "url": "https://github.com/iiwish/kgdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/kgdiff.git",
    "directory": "packages/g6"
  },
  "license": "MIT",
  "author": "iiwish",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kgdiff/core": "workspace:*",
    "@kgdiff/scene": "workspace:*"
  },
  "peerDependencies": {
    "@antv/g6": "^5.1.0"
  },
  "devDependencies": {
    "@antv/g6": "5.1.1"
  }
}
