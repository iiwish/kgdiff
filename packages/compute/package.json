{
  "name": "@kgdiff/compute",
  "version": "0.9.0",
  "description": "kgdiff's Rust engine compiled to WebAssembly: diff, parsers and layout, the same bytes as the kgdiff CLI in every JavaScript engine.",
  "keywords": [
    "kgdiff",
    "diff",
    "knowledge-graph",
    "webassembly"
  ],
  "homepage": "https://github.com/iiwish/kgdiff/tree/main/packages/compute#readme",
  "bugs": {
    "url": "https://github.com/iiwish/kgdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/kgdiff.git",
    "directory": "packages/compute"
  },
  "license": "MIT",
  "author": "iiwish",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./compute.wasm": "./wasm/compute.wasm",
    "./layout.wasm": "./wasm/layout.wasm",
    "./formats.wasm": "./wasm/formats.wasm"
  },
  "files": [
    "dist",
    "src",
    "wasm"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:wasm": "tsx scripts/build-wasm.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kgdiff/core": "workspace:*",
    "@kgdiff/formats": "workspace:*",
    "@kgdiff/layout": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
