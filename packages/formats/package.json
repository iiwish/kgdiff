{
  "name": "@kgdiff/formats",
  "version": "0.10.0",
  "description": "Parsers that turn RDF (Turtle, N-Triples, N-Quads, TriG, RDF/XML, JSON-LD), OBO and common JSON graph shapes into kgdiff graphs.",
  "keywords": [
    "kgdiff",
    "rdf",
    "turtle",
    "rdf-xml",
    "owl",
    "json-ld",
    "obo",
    "parser"
  ],
  "homepage": "https://github.com/iiwish/kgdiff/tree/main/packages/formats#readme",
  "bugs": {
    "url": "https://github.com/iiwish/kgdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/kgdiff.git",
    "directory": "packages/formats"
  },
  "license": "MIT",
  "author": "iiwish",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kgdiff/compute": "workspace:*",
    "@kgdiff/core": "workspace:*"
  }
}
