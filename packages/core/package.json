{
  "name": "@kgdiff/core",
  "version": "0.10.0",
  "description": "Semantic diff engine for knowledge graphs: matching, change classification, hunks and invertible deltas.",
  "keywords": [
    "kgdiff",
    "diff",
    "knowledge-graph",
    "ontology",
    "graph"
  ],
  "homepage": "https://github.com/iiwish/kgdiff/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/iiwish/kgdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiwish/kgdiff.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "iiwish",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/graph.v1.json": "./schema/graph.v1.json",
    "./schema/diff.v1.json": "./schema/diff.v1.json",
    "./schema/diff-packed.v1.json": "./schema/diff-packed.v1.json",
    "./schema/delta.v1.json": "./schema/delta.v1.json",
    "./schema/layout.v2.json": "./schema/layout.v2.json",
    "./schema/report.v1.json": "./schema/report.v1.json"
  },
  "files": [
    "dist",
    "schema",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {}
}
